{
	"name": "streamkist",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": "1.4.4"
	},
	"scripts": {
		"dev": "bun --bun run nuxt dev",
		"generate": "bun --bun run nuxt generate",
		"build": "bun run generate && bun scripts/verify-static.ts",
		"preview": "bun scripts/serve-static.ts",
		"typecheck": "bun --bun run nuxt typecheck",
		"test": "bun test",
		"lint": "biome lint .",
		"format": "biome format . --fix && prettier --write \"app/**/*.vue\" \"**/*.md\" \".github/**/*.yml\" \"public/**/*.svg\"",
		"check:http": "bun scripts/check-static-http.ts",
		"test:browser": "playwright test",
		"render:social": "bun scripts/render-social.ts"
	},
	"dependencies": {
		"@nuxt/ui": "4.12.2",
		"@tabler/icons-vue": "3.52.0",
		"nuxt": "4.6.4",
		"vue": "3.5.45"
	},
	"overrides": {
		"nitropack": "2.13.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"prettier": "3.10.1",
		"typescript": "6.0.3",
		"vue-tsc": "3.3.14"
	}
}
